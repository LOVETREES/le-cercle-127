{
  "expo": {
    "name": "Le Cercle 127",
    "slug": "le-cercle-127",
    "scheme": "cercle127",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080b17",
    "primaryColor": "#d8b66b",
    "description": "Confiez vos rêves, gardez-les dans votre Grimoire et explorez les symboles avec les Sept Sœurs du Cercle 127.",
    "ios": {
      "bundleIdentifier": "com.lecercle127.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr"
      }
    },
    "android": {
      "package": "com.lecercle127.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#080b17",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#080b17"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#d8b66b"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://lecercle127.com/wp-json",
      "eas": {
        "projectId": "05046b88-2152-4a0a-9857-b16979a81911"
      }
    }
  }
}
